{
  "name": "@blert/socket-server",
  "version": "0.1.0",
  "description": "Websocket server for Blert",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../.prettierignore",
    "start": "node ./dist/app.js",
    "dev": "NODE_ENV=development tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@blert/common": "file:../common",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-protobuf": "^4.0.2",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "winston": "^3.18.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-watch": "^7.2.1"
  }
}

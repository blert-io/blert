{
  "name": "@blert/challenge-server",
  "version": "0.1.0",
  "description": "Server processing Blert challenges",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../.prettierignore",
    "start": "node ./dist/app.js",
    "dev": "NODE_ENV=development tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@blert/common": "file:../common",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "google-protobuf": "^4.0.2",
    "piscina": "^5.3.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-watch": "^6.0.4"
  }
}

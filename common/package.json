{
  "name": "@blert/common",
  "version": "0.1.0",
  "description": "Shared blert web and server code",
  "private": true,
  "license": "MIT",
  "scripts": {
    "generate-protos": "mkdir -p generated dist/generated && protoc -I ../proto ../proto/*.proto --js_out=import_style=commonjs:generated --ts_out=generated && cp ../proto/*_definitions.json generated/",
    "build": "npm run generate-protos && tsc && cp generated/*.d.ts dist/generated",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../.prettierignore",
    "migration:create": "tsc && node dist/migrations/migrate.js create $1",
    "migration:script": "tsc && node dist/migrations/migrate.js script $1",
    "migration:run": "tsc && node dist/migrations/migrate.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "generated/*.d.ts"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@smithy/core": "3.20.0"
  }
}
